{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database={DB_NAME};User ID={DB_USER};Password={DB_PASSWORD};Charset=utf8;"
  }
